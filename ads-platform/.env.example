# Quando "true", nenhuma escrita é enviada às plataformas de anúncio, apenas registrada.
DRY_RUN=true

# Supabase (Project Settings → API). Estas duas são públicas por natureza.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta do Supabase (Project Settings → API Keys → secret / service_role).
# Só no servidor: nunca use o prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Trigger.dev (coleta diária). O project ref já está em trigger.config.ts; defina só
# para usar outro projeto. A publicação usa `npx trigger.dev@4 login` + `deploy`.
TRIGGER_PROJECT_REF=
